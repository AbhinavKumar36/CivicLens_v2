<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#060e20">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/logo"
        android:contentDescription="Civic Connect Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Civic Connect"
        android:textColor="#ffffff"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnCitizenProfile"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#4f46e5"
        android:textColor="#ffffff"
        android:textStyle="bold"
        android:text="CITIZEN PROFILE"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnWorkerDashboard"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#8b5cf6"
        android:textColor="#ffffff"
        android:textStyle="bold"
        android:text="WORKER DASHBOARD"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnEmergencySOS"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#ef4444"
        android:textColor="#ffffff"
        android:textStyle="bold"
        android:text="EMERGENCY SOS"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnMapDashboard"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#0ea5e9"
        android:textColor="#ffffff"
        android:textStyle="bold"
        android:text="LIVE MAP &amp; PLANNING" />

</LinearLayout>
